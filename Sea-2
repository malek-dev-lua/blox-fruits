};

local Noclip = { active = false };

local function validNum(n)
    return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge;
end;

local function getChar()
    local c = plr.Character
    if not c then return nil, nil end
    return c, c:FindFirstChild("HumanoidRootPart")
end

local function applyNoclip()
    local char = getChar()
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.CanTouch = true
            p.CanQuery = true
        end
    end
end

local function applyNormalCollisions()
    local char = getChar()
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local n = p.Name
            if n == "UpperTorso" or n == "LowerTorso" or n == "Torso" or n == "Head" then
                p.CanCollide = true
            else
                p.CanCollide = false
            end
            p.CanTouch = true
            p.CanQuery = true
        end
    end
end

local function saveCharacterState()
    if Flight.savedState then return end
    local char, hrp = getChar()
    if not char or not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.Health <= 0 then return end
    Flight.savedState = {
        walkSpeed = hum.WalkSpeed,
        jumpPower = hum.JumpPower,
        autoRotate = hum.AutoRotate,
        platformStand = hum.PlatformStand,
        gravity = workspace.Gravity,
        anchored = hrp.Anchored,
    }
end

local function restoreCharacterState()
    local char, hrp = getChar()
    local saved = Flight.savedState
    Flight.savedState = nil
    if not saved then return end
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            pcall(function()
                hum.WalkSpeed = saved.walkSpeed
                hum.JumpPower = saved.jumpPower
                hum.AutoRotate = saved.autoRotate
                hum.PlatformStand = saved.platformStand
                hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end
    if hrp then
        pcall(function()
            hrp.Anchored = saved.anchored
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if workspace.Gravity ~= saved.gravity then
        workspace.Gravity = saved.gravity
    end
end

local function startFlight()
    if Flight.active then return true end
    local char, hrp = getChar()
    if not char or not hrp then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    if Flight.savedState and Flight.savedChar ~= char then
        Flight.savedState = nil
    end
    Flight.savedChar = char

    saveCharacterState()

    if not Flight.bodyVelocity or Flight.bodyVelocity.Parent ~= hrp then
        if Flight.bodyVelocity then pcall(function() Flight.bodyVelocity:Destroy() end) end
        Flight.bodyVelocity = Instance.new("BodyVelocity")
        Flight.bodyVelocity.Name = "Irish_UnifiedBV"
        Flight.bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        Flight.bodyVelocity.Velocity = Vector3.zero
        Flight.bodyVelocity.Parent = hrp
    end
    if not Flight.bodyGyro or Flight.bodyGyro.Parent ~= hrp then
        if Flight.bodyGyro then pcall(function() Flight.bodyGyro:Destroy() end) end
        Flight.bodyGyro = Instance.new("BodyGyro")
        Flight.bodyGyro.Name = "Irish_UnifiedBG"
        Flight.bodyGyro.MaxTorque = Vector3.new(0, 9e9, 0)
        Flight.bodyGyro.P = 1e4
        Flight.bodyGyro.D = 1000
        Flight.bodyGyro.CFrame = hrp.CFrame
        Flight.bodyGyro.Parent = hrp
    end
    if not Flight.antiGrav or Flight.antiGrav.Parent ~= hrp then
        if Flight.antiGrav then pcall(function() Flight.antiGrav:Destroy() end) end
        Flight.antiGrav = Instance.new("BodyForce")
        Flight.antiGrav.Name = "Irish_UnifiedAntiGrav"
        Flight.antiGrav.Force = Vector3.new(0, workspace.Gravity * 3.5, 0)
        Flight.antiGrav.Parent = hrp
    end

    hrp.Anchored = false
    pcall(function()
        hum.PlatformStand = false
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
    end)

    Flight.active = true
    Noclip.active = true
    applyNoclip()
    return true
end

local function stopFlight()
    if not Flight.active and not Flight.savedState then return end

    local char, hrp = getChar()
    if Flight.bodyVelocity then pcall(function() Flight.bodyVelocity:Destroy() end); Flight.bodyVelocity = nil end
    if Flight.bodyGyro then pcall(function() Flight.bodyGyro:Destroy() end); Flight.bodyGyro = nil end
    if Flight.antiGrav then pcall(function() Flight.antiGrav:Destroy() end); Flight.antiGrav = nil end

    if hrp then
        for _, o in ipairs(hrp:GetChildren()) do
            if o.Name:match("^Irish_") then pcall(function() o:Destroy() end) end
        end
    end

    Flight.active = false
    Flight.savedChar = nil
    Noclip.active = false

    if hrp then
        pcall(function()
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    restoreCharacterState()
    applyNormalCollisions()
end

local function stopAllMovement()
    stopFlight()
    local char = getChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        pcall(function()
            hum.PlatformStand = false
            hum.AutoRotate = true
        end)
    end
    applyNormalCollisions()
end

