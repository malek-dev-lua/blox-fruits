local function isFactoryRaidActive()
    local enemies = workspace:FindFirstChild("Enemies")
    local core = enemies and enemies:FindFirstChild("Core")
    if core then
        local hum = core:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return true end
    end
    local main = PlayerGui:FindFirstChild("Main")
    local top = main and main:FindFirstChild("TopHUDList")
    local raidTimer = top and top:FindFirstChild("RaidTimer")
    if raidTimer and raidTimer.Visible then return true end
    return false
end

local function findFactoryCore()
    local hrp = ctGetHRP()
    if not hrp then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    local enf = workspace:FindFirstChild("Enemies")
    if enf then
        for _, e in ipairs(enf:GetChildren()) do
            if e.Name:find("Core") and not Players:GetPlayerFromCharacter(e) then
                local eh = e:FindFirstChildOfClass("Humanoid")
                local ehp = e:FindFirstChild("HumanoidRootPart")
                if eh and ehp and eh.Health > 0 then
                    local d = (ehp.Position - myPos).Magnitude
                    if d < bestDist then best, bestDist = e, d end
                end
            end
        end
    end
    return best
end

local function flyToFactory()
    local core = findFactoryCore()
    local dest
    if core then
        local mhrp = core:FindFirstChild("HumanoidRootPart")
        if mhrp then dest = mhrp.Position + Vector3.new(0, Cfg.HoverHeight or 3, 0) end
    end
    if not dest then dest = Vector3.new(427.79, 182.54, -431.78) + Vector3.new(0, Cfg.HoverHeight or 3, 0) end

    State.FactoryLockedPosition = dest
    State.FactoryLockedAtFactory = true
    local t0 = tick()
    while tick() - t0 < 30 do
        if not Cfg.AutoFarmFactory or State.IsScriptDestroyed then break end
        if State.FruitPriorityActive then break end
        local hrp = ctGetHRP()
        if not hrp then break end
        if (hrp.Position - dest).Magnitude <= (Cfg.FlyArrivalRadius or 5) then break end
        if not Flight.active then startFlight() end
        moveToTarget(CFrame.new(dest), Cfg.FactoryFlySpeed)
        task.wait(0.05)
    end
end

