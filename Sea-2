local function moveToTarget(tgtCF)
    local char, hrp = getChar()
    if not char or not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if not tgtCF then return end
    local tp
    if typeof(tgtCF) == "CFrame" then tp = tgtCF.Position
    elseif typeof(tgtCF) == "Vector3" then tp = tgtCF
    else return end
    if not validNum(tp.X) then return end

    if not Flight.active then
        if not startFlight() then return end
    end

    local cp = hrp.Position
    if not validNum(cp.X) then return end
    local dv = tp - cp
    local td = dv.Magnitude
    if not validNum(td) then return end

    State.IsMoving = true

    local fs = tonumber(Cfg.FlySpeed) or 170;
    local cv = hrp.AssemblyLinearVelocity.Magnitude
    if not validNum(cv) then cv = 0 end
    local ms = math.clamp(fs, 50, 200)
    local bd = math.max(3.5, (cv * cv) / (2 * ms) * 0.15)
    bd = math.clamp(bd, 3.5, 8)

    if td <= bd then
        if Flight.bodyVelocity then Flight.bodyVelocity.Velocity = Vector3.zero end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if hum:GetState() ~= Enum.HumanoidStateType.Freefall then
                hum:ChangeState(Enum.HumanoidStateType.Freefall)
            end
        end)
        return
    end

    local ds = ms
    if td < 30 then ds = math.max(15, ms * (td / 30)) end
    if td < 10 then ds = math.max(8, ms * (td / 10) * 0.5) end

    local dir = dv.Unit
    local vel = Vector3.new(dir.X * ds, dir.Y * ds, dir.Z * ds)
    if Flight.bodyVelocity and Flight.bodyVelocity.Parent == hrp then
        Flight.bodyVelocity.Velocity = vel
    end
    if Flight.bodyGyro and Flight.bodyGyro.Parent == hrp then
        Flight.bodyGyro.MaxTorque = Vector3.new(0, 9e9, 0)
        local hd = Vector3.new(dv.X, 0, dv.Z)
        if hd.Magnitude > 1.0 then
            Flight.bodyGyro.CFrame = CFrame.lookAt(cp, cp + hd)
        else
            local yaw = math.rad(hrp.Orientation.Y)
            Flight.bodyGyro.CFrame = CFrame.new(cp) * CFrame.Angles(0, yaw, 0)
        end
    end
end

