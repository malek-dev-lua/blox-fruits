local function getStock(isAdvanced)
    local CommF_ = RS:WaitForChild("Remotes"):WaitForChild("CommF_")
    local ok, data = pcall(function()
        return CommF_:InvokeServer("GetFruits", isAdvanced == true)
    end)
    if not ok or typeof(data) ~= "table" then return nil end
    local stock = {}
    for _, fruit in ipairs(data) do
        if fruit and fruit.OnSale then
            table.insert(stock, { Name = fruit.Name, Price = fruit.Price })
        end
    end
    return stock
end

local function formatStock(title, stock)
    if not stock then return title .. ": (error)" end;
    local lines = {title .. ":"}
    for _, f in ipairs(stock) do
        table.insert(lines, string.format("  - %s | %s Beli", f.Name, tostring(f.Price)))
    end
    if #stock == 0 then table.insert(lines, "  (empty)") end;
    return table.concat(lines, "\n")
end

local function cleanTimerText(text)
    if type(text) ~= "string" then return "--:--" end;
    local cleanText = string.gsub(string.gsub(text, "<.->", ""), "[^%d:]", "")
    local h, m, s = string.match(cleanText, "(%d+):(%d+):(%d+)")
    if h then return string.format("%02d:%02d:%02d", tonumber(h), tonumber(m), tonumber(s)) end;
    local mm, ss = string.match(cleanText, "(%d+):(%d+)")
    if mm then return string.format("%02d:%02d", tonumber(mm), tonumber(ss)) end;
    return cleanText ~= "" and cleanText or "--:--";
end

