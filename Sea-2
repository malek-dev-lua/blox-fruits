local function isPosInsideShip(pos)
    if not pos then return false end;
    local v;
    if typeof(pos) == "CFrame" then v = pos.Position;
    elseif typeof(pos) == "Vector3" then v = pos;
    else return false end;
    return v.Z > SHIP_Z_THRESHOLD;
end;

local function goIntoShip()
    if State.ShipTransitionLock then return false end;
    State.ShipTransitionLock = true;
    local ok = pcall(function()
        local char = plr.Character;
        local hrp = char and char:FindFirstChild("HumanoidRootPart");
        if not hrp then return end;
        if isInsideShip() then return end;
        
        local ap = SHIP_ENTRY_GATE.Position + SHIP_GATE_OFFSET;
        local t0 = tick()
        
        while (hrp.Position - ap).Magnitude > 5 and tick() - t0 < 25 do
            moveToTarget(CFrame.new(ap))
            task.wait(0.05)
        end
        
        if Flight.bodyVelocity then Flight.bodyVelocity.Velocity = Vector3.zero end
        if Flight.bodyGyro then Flight.bodyGyro.CFrame = hrp.CFrame end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        
        task.wait(0.2)
        
        local cf = getCommF();
        if cf then 
            pcall(function() cf:InvokeServer("requestEntrance", SHIP_INSIDE_POS) end);
        end;
        
        local ws = tick();
        while tick() - ws < 4.0 and not State.IsScriptDestroyed do
            task.wait(0.05);
            char = plr.Character; hrp = char and char:FindFirstChild("HumanoidRootPart");
            if hrp and isInsideShip() then break end;
        end;
    end);
    stopAllMovement();
    task.wait(0.2);
    State.ShipTransitionLock = false;
    return ok;
end;

