local function mobSweepGetNextTarget()
    if #State.MobSweepMem == 0 then return nil end
    local now = tick()
    if State.MobSweepIndex < 1 or State.MobSweepIndex > #State.MobSweepMem then
        State.MobSweepIndex = 1
    end
    if State.MobSweepLastSwitch == 0 then
        State.MobSweepLastSwitch = now
    end
    if now - State.MobSweepLastSwitch >= MOB_SWEEP_CONFIG.pause then
        State.MobSweepIndex = State.MobSweepIndex + 1
        if State.MobSweepIndex > #State.MobSweepMem then
