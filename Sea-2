    Chest1 = { label = "Silver Chest" }, Chest2 = { label = "Gold Chest" },
    Chest3 = { label = "Diamond Chest" }, XmasChest = { label = "Xmas Chest" },
};
local CT_BLOCKED = { DiamondChest = true, FragChest = true };

local function ctGetAllChests()
    local out = {};
    local visualRoot = workspace:FindFirstChild("ChestModels");
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and not CT_BLOCKED[d.Name] and CT_ALLOWED[d.Name] then
            local isVisual = false;
            local p = d;
            while p and p ~= workspace do
                if p == visualRoot then isVisual = true; break; end;
                p = p.Parent;
            end;
            if not isVisual and d:FindFirstChildOfClass("TouchTransmitter") then
                table.insert(out, d);
            end;
        end;
    end;
    return out;
end;

local function ctGetHRP()
    local char = plr.Character;
    return char and char:FindFirstChild("HumanoidRootPart");
end;

local function ctGetHum()
    local char = plr.Character;
    return char and char:FindFirstChildWhichIsA("Humanoid");
end;

local function ctIsValidChest(c)
    return c and c.Parent ~= nil and c:IsDescendantOf(workspace) and not CT_BLOCKED[c.Name];
end;

local function ctSortChests(list)
    local hrp = ctGetHRP();
    if not hrp then return list end;
    table.sort(list, function(a, b)
        local distA = (a.Position - hrp.Position).Magnitude;
        local distB = (b.Position - hrp.Position).Magnitude;
        return distA < distB;
    end);
    return list;
end;

local ctFlying = false;

local function ctFlyTo(position)
    local char, hrp = getChar()
    if not char or not hrp then return false end
    if ctFlying then return false end
    if CT_STOP.flag then return false end

    ctFlying = true
    local ok = pcall(function()
        if not startFlight() then return end
        local t0 = tick()
        while not CT_STOP.flag and ctIsCurrent() do
            local hrp2 = ctGetHRP()
            if not hrp2 then break end
            local dist = (position - hrp2.Position).Magnitude
            if dist <= 2 then break end
            if tick() - t0 > 30 then break end
            moveToTarget(CFrame.new(position))
            task.wait(0.03)
        end
    end)
    ctFlying = false
    return ok
end

local function ctLandingPos(chest)
    return chest.Position + Vector3.new(0, CT_CONFIG.heightAboveChest, 0);
end;

local ctSweepMem = {};
local function ctRememberSpot(pos)
    for _, p in ipairs(ctSweepMem) do
        if (p.pos - pos).Magnitude < 40 then return end
    end
    if #ctSweepMem < CT_CONFIG.sweepMaxSpots then table.insert(ctSweepMem, { pos = pos }) end;
end;

local function ctRememberChests(list)
    for _, c in ipairs(list) do ctRememberSpot(ctLandingPos(c)) end;
end;

local function ctHasChestInRange()
    local hrp = ctGetHRP();
    if not hrp then return false end;
    for _, c in ipairs(ctGetAllChests()) do
        if not CT_CONFIG.maxDistance or (c.Position - hrp.Position).Magnitude <= CT_CONFIG.maxDistance then
            return true;
        end;
    end;
    return false;
end;

local ctRunLock = false;
local function ctRunChests()
    if ctRunLock then return end;
    ctRunLock = true;
    repeat
        local skipCycle = false;
        if (Cfg.AutoFarmFactory and State.FactoryCoreAlive) or (Cfg.AutoCollectFruit and State.FruitPriorityActive) then
            task.wait(0.5);
            skipCycle = true;
        end
        if not skipCycle then
            local list = ctGetAllChests();
            local queue = {};
            for _, c in ipairs(list) do table.insert(queue, c) end;
            ctRememberChests(list);
            if CT_CONFIG.sortByDistance then ctSortChests(queue) end;

            for _, chest in ipairs(queue) do
                if CT_STOP.flag then break end;
                if (Cfg.AutoFarmFactory and State.FactoryCoreAlive) or (Cfg.AutoCollectFruit and State.FruitPriorityActive) then break end

                if ctIsValidChest(chest) then
                    local hrpNow = ctGetHRP();
                    if not hrpNow then break end;
                    if not CT_CONFIG.maxDistance or (chest.Position - hrpNow.Position).Magnitude <= CT_CONFIG.maxDistance then
                        ctFlyTo(ctLandingPos(chest));
                        task.wait(CT_CONFIG.waitAtChest);
                    end
                end
            end

            if not ctHasChestInRange() and CT_CONFIG.sweepWhenEmpty and #ctSweepMem > 0 and not CT_STOP.flag then
                local idx = 1;
                local sweepRange = CT_CONFIG.sweepMaxDistance or CT_CONFIG.maxDistance or 8000;
                while not ctHasChestInRange() and CT_CONFIG.sweepWhenEmpty and not CT_STOP.flag and ctIsCurrent() do
                    if (Cfg.AutoFarmFactory and State.FactoryCoreAlive) or (Cfg.AutoCollectFruit and State.FruitPriorityActive) then break end
                    local spot = ctSweepMem[idx];
                    if not spot then idx = 1; spot = ctSweepMem[1] end;
                    local hrp2 = ctGetHRP();
                    if not hrp2 then break end;
                    if (spot.pos - hrp2.Position).Magnitude <= sweepRange then ctFlyTo(spot.pos) end;
                    task.wait(CT_CONFIG.sweepPause or 0.2);
                    idx = idx + 1;
                end;
            end;
        end
        if CT_CONFIG.loopForever and not CT_STOP.flag then task.wait(CT_CONFIG.cycleDelay or 1) end;
    until not CT_CONFIG.loopForever or CT_STOP.flag or not ctIsCurrent();
    stopAllMovement();
    ctRunLock = false;
    CT_STOP.flag = false;
end;

